class LocalizedString {
  definition {
    String specifying the language, script, and country of its text.
    A language-script(-country) combination identifies a spelling system
    as registered under ISO 24229 (written-language conversion systems).
  }
  +language: Iso639Code[0..*] {
    definition {
      The language of the string.
    }
  }
  +script: Iso15924Code[0..*] {
    definition {
      The script of the string.
    }
  }
  +country: Iso3166Code[0..*] {
    definition {
      The country/locale variant of the string.
    }
  }
  +content: String {
    definition {
      The value of the string
    }
  }
}

