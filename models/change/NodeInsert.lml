class NodeInsert {
  definition {
    Specification of the insertion
of a data node in a BasicDocument.
  }
  +content: BasicElement {
    definition {
A data element conforming to _BasicElement_ to be inserted into the specified BasicDocument.
    }
  }
  +position: NodePosition[0..1] {
    definition {
The position where the content is to be inserted: a container node and
a zero-based ordinal among its children. When omitted, the content is
appended to the end of the child sequence of the target node.
    }
  }
}

