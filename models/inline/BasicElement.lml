class BasicElement {
  definition {
    Container of inline content in BasicDocument.
  }
  +contribMetadata: ContributionElementMetadata[0..*] {
    definition {
      Metadata of the contributor responsible for the action.
    }
  }
  +attributes: Attribute[0..*] {
    definition {
      Entries from the generic attribute register: an open key-value
      set that markup languages bind their own attribute types into.
    }
  }
}

