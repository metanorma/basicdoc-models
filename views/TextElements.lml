  association {
    owner BasicElement
    member TextElement
    owner_type inheritance
  }
  association {
    owner TextElement
    member IdElement
    owner_type inheritance
  }
  association {
    owner TextElement
    member ReferenceElement
    owner_type inheritance
  }
  association {
    owner TextElement
    member PureTextElement
