diagram EmptyElements {
  title "EmptyElements"
  include ../models/inline/BasicElement.lml
  include ../models/inline/empty/PageBreakElement.lml
  include ../models/inline/empty/LineBreakElement.lml
  include ../models/inline/empty/HorizontalRuleElement.lml
  include ../models/inline/empty/IndexElement.lml

  association {
    owner BasicElement
    member PageBreakElement
    owner_type inheritance
  }
  association {
    owner BasicElement
    member LineBreakElement
    owner_type inheritance
  }
  association {
    owner BasicElement
    member HorizontalRuleElement
    owner_type inheritance
  }
  association {
    owner BasicElement
    member IndexElement
    owner_type inheritance
  }
}
