diagram MultiParagraphs {
  title "MultiParagraphs"
  include ../models/blocks/paragraphs/ParagraphWithFootnote.lml
  include ../models/blocks/multiparagraphs/ParagraphsBlock.lml
  include ../models/blocks/multiparagraphs/QuoteBlock.lml
  include ../models/blocks/multiparagraphs/ReviewBlock.lml
  include ../models/blocks/multiparagraphs/AdmonitionBlock.lml
  include ../models/blocks/multiparagraphs/AdmonitionType.lml
  include ../models/blocks/amend/AmendBlock.lml
  include ../models/datatypes/Attribute.lml
  include ../models/blocks/amend/ChangeType.lml
  include ../models/blocks/amend/NewContentBlock.lml
  include ../models/sections/HierarchicalSection.lml
  include ../models/blocks/BasicBlock.lml
  include ../models/bibdata/relaton/Contributor.lml
  include ../models/bibdata/relaton/LocalityStack.lml
  include ../models/bibdata/relaton/BibItemLocality.lml

  association {
    owner ParagraphWithFootnote
    member ParagraphsBlock
    owner_type inheritance
  }
  association {
    owner ParagraphsBlock
    member QuoteBlock
    owner_type inheritance
  }
  association {
    owner ParagraphsBlock
    member ReviewBlock
    owner_type inheritance
  }
  association {
    owner ParagraphsBlock
    member AdmonitionBlock
    owner_type inheritance
  }

  association {
    owner AdmonitionType
    member AdmonitionBlock
    member_type direct
  }
  association {
    owner ParagraphsBlock
    member AmendBlock
    member_type inheritance
  }
  association {
    owner AmendBlock
    member ChangeType
    member_type direct
  }
  association {
    owner AmendBlock
    member Attribute
    member_type direct
  }
  association {
    owner AmendBlock
    member Contributor
    member_type direct
  }
  association {
    owner AmendBlock
    member BibItemLocality
    owner_type direct
  }
  association {
    owner AmendBlock
    member LocalityStack
    owner_type direct
  }
  association {
    owner AmendBlock
    member NewContentBlock
    owner_type direct
  }
  association {
    owner NewContentBlock
    member BasicBlock
    owner_type direct
  }
  association {
    owner NewContentBlock
    member HierarchicalSection
    owner_type direct
  }
}
