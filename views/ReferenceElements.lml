diagram ReferenceElements {
  title "ReferenceElements"
  include ../models/inline/BasicElement.lml
  include ../models/inline/reference/ReferenceElement.lml
  include ../models/inline/reference/Citation.lml
  include ../models/inline/reference/ReferenceToIdElement.lml
  include ../models/inline/reference/IndexXrefElement.lml
  include ../models/inline/reference/ReferenceToLinkElement.lml
  include ../models/inline/reference/ReferenceToCitationElement.lml
  include ../models/inline/reference/ReferenceToIdWithParagraphElement.lml
  include ../models/inline/reference/Callout.lml
  include ../models/inline/reference/Footnote.lml
  include ../models/inline/reference/ReferenceFormat.lml

  association {
    owner BasicElement
    member ReferenceElement
    owner_type inheritance
  }
  association {
    owner ReferenceElement
    member IndexXrefElement
    owner_type inheritance
  }

  association {
    owner ReferenceElement
    member ReferenceToIdElement
    owner_type inheritance
  }
  association {
    owner ReferenceElement
    member ReferenceToLinkElement
    owner_type inheritance
  }
  association {
    owner ReferenceElement
    member ReferenceToCitationElement
    owner_type inheritance
  }

  association {
    owner ReferenceFormat
    member ReferenceElement
    member_type direct
  }

  association {
    owner Citation
    member ReferenceToCitationElement
    owner_type inheritance
  }

  association {
    owner ReferenceToIdElement
    member ReferenceToIdWithParagraphElement
    owner_type inheritance
  }
  association {
    owner ReferenceToIdElement
    member Callout
    owner_type inheritance
  }

  association {
    owner ReferenceToIdWithParagraphElement
    member Footnote
    owner_type inheritance
  }
}
