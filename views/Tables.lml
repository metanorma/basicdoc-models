diagram Tables {
  title "Tables"
  include ../models/blocks/BasicBlock.lml
  include ../models/blocks/tables/TableBlock.lml
  include ../models/blocks/tables/TextTableRow.lml
  include ../models/blocks/tables/TableCell.lml
  include ../models/blocks/tables/TextTableCell.lml
  include ../models/blocks/tables/ParagraphTableCell.lml
  include ../models/blocks/tables/CellTextAlignment.lml
  include ../models/blocks/tables/CellVerticalAlignment.lml

  association {
    owner BasicBlock
    member TableBlock
    owner_type inheritance
  }

  association {
    owner TextTableRow
    member TableBlock
    member_type direct
  }
  association {
    owner TableCell
    member TextTableRow
    member_type direct
  }
  association {
    owner TableCell
    member TextTableCell
    owner_type inheritance
  }
  association {
    owner TableCell
    member ParagraphTableCell
    owner_type inheritance
  }

  association {
    owner CellTextAlignment
    member TableCell
    member_type direct
  }
  association {
    owner CellVerticalAlignment
    member TableCell
    member_type direct
  }

}
