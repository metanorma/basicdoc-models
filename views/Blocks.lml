diagram Blocks {
  title "Blocks"

  include ../models/blocks/BasicBlock.lml
  include ../models/blocks/BasicBlockNoNotes.lml
  include ../models/blocks/NoteBlock.lml
  include ../models/contribmetadata/ContributionElementMetadata.lml
  include ../models/paragraphs/ParagraphBlock.lml

  association {
    owner BasicBlock
    member BasicBlockNoNotes
    member_type inheritance
  }
  association {
    owner NoteBlock
    member BasicBlockNoNotes
    member_type inheritance
  }
  association {
    owner BasicBlock
    member NoteBlock
    member_type direct
  }
  association {
    owner BasicBlockNoNotes
    member ContributionElementMetadata
    member_type direct
  }
  association {
    owner NoteBlock
    member ParagraphBlock
    member_type direct
  }
}
