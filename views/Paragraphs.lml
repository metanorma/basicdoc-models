diagram Paragraphs {
  title "Paragraphs"
  include ../models/blocks/BasicBlock.lml
  include ../models/blocks/paragraphs/ParagraphBlock.lml
  include ../models/blocks/paragraphs/ParagraphWithFootnote.lml
  include ../models/blocks/paragraphs/TextAlignment.lml
  include ../models/blocks/multiparagraphs/ParagraphsBlock.lml

  association {
    owner BasicBlock
    member ParagraphBlock
    owner_type inheritance
  }
  association {
    owner BasicBlock
    member ParagraphsBlock
    owner_type inheritance
  }

  association {
    owner ParagraphBlock
    member ParagraphWithFootnote
    owner_type inheritance
  }
  association {
    owner TextAlignment
    member ParagraphBlock
    member_type direct
  }
}
