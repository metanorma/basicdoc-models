<section class="hero wrap">
  <div class="hero-grid">
    <div>
      <p class="eyebrow">Model atlas</p>
      <h1>Document structure, drawn as plates</h1>
      <p class="hero-lead">
        <strong>BasicDocument</strong> ("BasicDoc") expresses the structure of
        generic documents in a lightweight form: a base document metamodel that
        others map to, specialize upon, or use for interchange. Documents
        consist of sections, sections of blocks, blocks of inline elements —
        and the tiers never mix. These plates render that model from its
        canonical LutaML sources.
      </p>
    </div>
    <dl class="hero-meta">
      <div>
        <dt>Diagram plates</dt>
        <dd><%= plates.size %></dd>
      </div>
      <div>
        <dt>LML model files</dt>
        <dd><%= model_count %></dd>
      </div>
      <div>
        <dt>Source of truth</dt>
        <dd>LML, not RNC</dd>
      </div>
    </dl>
  </div>
</section>

<section class="wrap">
  <div class="reading-rule">
    <strong>How to read these plates</strong>
    <p>
      The diagrams are rendered from the LML definition modules under
      <code>models/**/*.lml</code> — the models <em>are</em> the LML files.
      The RNC grammars in <code>grammars/</code> are implementation grammars
      that accompany the LML, never a substitute for it: change the model by
      editing the LML, never by editing only a grammar.
    </p>
  </div>
</section>

<section class="wrap" aria-labelledby="plates-heading">
  <div class="toolbar">
    <label id="domain-label">Domain</label>
    <div class="chip-row" role="group" aria-labelledby="domain-label">
      <button type="button" class="chip" data-domain-filter="all" aria-pressed="true">All</button>
      <% domains.each do |domain| %>
        <button type="button" class="chip" data-domain-filter="<%= h(domain) %>" aria-pressed="false"><%= h(domain) %></button>
      <% end %>
    </div>
    <input class="search" type="search" placeholder="Filter plates…" data-plate-search aria-label="Filter plates">
  </div>

  <h2 id="plates-heading" class="visually-hidden" style="position:absolute;left:-9999px">Plates</h2>
  <ul class="plate-grid">
    <% plates.each_with_index do |plate, i| %>
      <li data-plate
          data-domains="<%= h(plate.domains.join(',')) %>"
          data-search="<%= h([plate.title, plate.slug, plate.domains.join(' '), plate.includes.join(' ')].join(' ')) %>">
        <a class="plate-card" href="<%= asset_path("models/#{plate.slug}.html") %>">
          <div class="plate-frame">
            <img src="<%= asset_path("images/#{plate.image}") %>" alt="UML diagram for <%= h(plate.title) %>" loading="lazy">
          </div>
          <div class="plate-body">
            <div class="plate-no">Plate <%= format('%02d', i + 1) %></div>
            <h2><%= h(plate.title) %></h2>
            <div class="plate-meta"><%= plate.includes.size %> includes · <%= plate.associations %> associations</div>
            <% if plate.domains.any? %>
              <div class="domain-tags">
                <% plate.domains.first(4).each do |d| %>
                  <span class="domain-tag"><%= h(d) %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </a>
      </li>
    <% end %>
  </ul>
  <div class="empty-state" data-empty-state>No plates match this filter.</div>
</section>
