<article class="model-page wrap">
  <header class="model-head">
    <div>
      <p class="crumb">
        <a href="<%= asset_path('index.html') %>">Atlas</a>
        · <a href="<%= asset_path("domains/#{plate.tier}/index.html") %>"><%= h(plate.tier) %></a>
        · Plate <%= format('%02d', plate_index + 1) %> of <%= plate_total %>
      </p>
      <p class="eyebrow"><%= h(plate.domains.any? ? plate.domains.join(' · ') : 'basicdoc') %></p>
      <h1><%= h(plate.title) %></h1>
      <p class="model-summary">
        Diagram view <code>views/<%= h(plate.view_file) %></code> composing
        <%= plate.includes.size %> LML include<%= plate.includes.size == 1 ? '' : 's' %>
        and <%= plate.associations %> association<%= plate.associations == 1 ? '' : 's' %>.
      </p>
    </div>
    <div class="side-stats" aria-label="Plate statistics">
      <div class="stat"><b>Includes</b><span><%= plate.includes.size %></span></div>
      <div class="stat"><b>Associations</b><span><%= plate.associations %></span></div>
      <div class="stat"><b>Types</b><span><%= definitions.size %></span></div>
    </div>
  </header>

  <figure class="diagram-stage">
    <img src="<%= asset_path("images/#{plate.image}") %>" alt="Full UML diagram for <%= h(plate.title) %>">
  </figure>

  <section aria-label="Model definitions" class="defs">
    <h2 class="defs-heading">Model definitions</h2>
    <% definitions.each do |type| %>
      <article class="type-card" id="<%= h(type.name) %>">
        <header class="type-head">
          <h3><%= h(type.name) %></h3>
          <span class="kind kind-<%= h(type.kind.tr(' ', '-')) %>"><%= h(type.kind) %><% if type.stereotype %> <%= h(type.stereotype) %><% end %></span>
          <a class="type-src" href="<%= h("#{'https://github.com/metanorma/basicdoc-models/blob/main/'}#{type.file}") %>"><code><%= h(type.file) %></code></a>
        </header>
        <% if type.definition %>
          <p class="type-defn"><%= h(type.definition) %></p>
        <% end %>
        <% if type.attributes.any? %>
          <table class="attr-table">
            <thead>
              <tr><th>Attribute</th><th>Type</th><th>Cardinality</th><th>Definition</th></tr>
            </thead>
            <tbody>
              <% type.attributes.each do |attr| %>
                <tr>
                  <td><code><%= h(attr.visibility) %><%= h(attr.name) %></code></td>
                  <td>
                    <% bare = attr.type.sub(/<<[^>]*>>\s*/, '').strip %>
                    <% href = type_href(bare, 1) %>
                    <% if href %><a href="<%= h(href) %>"><%= h(attr.type) %></a><% else %><code><%= h(attr.type) %></code><% end %>
                  </td>
                  <td><%= h(attr.multiplicity.empty? ? '1' : attr.multiplicity) %></td>
                  <td class="attr-defn"><%= h(attr.definition || '') %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
        <% if type.values.any? %>
          <dl class="enum-values">
            <% type.values.each do |v| %>
              <div>
                <dt><code><%= h(v[:name]) %></code></dt>
                <dd><%= h(v[:definition] || '') %></dd>
              </div>
            <% end %>
          </dl>
        <% end %>
      </article>
    <% end %>
  </section>

  <nav class="pager" aria-label="Plate pagination">
    <% if prev_plate %>
      <a href="<%= asset_path("models/#{prev_plate.slug}.html") %>">
        <span>Previous</span>
        ← <%= h(prev_plate.title) %>
      </a>
    <% else %>
      <span></span>
    <% end %>
    <% if next_plate %>
      <a href="<%= asset_path("models/#{next_plate.slug}.html") %>" style="text-align:right">
        <span>Next</span>
        <%= h(next_plate.title) %> →
      </a>
    <% end %>
  </nav>
</article>
